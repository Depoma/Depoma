# ============================================================================
# Depoma — Environment Configuration Template (.env.example)
# Copy this file to .env for local development. NEVER commit real secrets.
# ============================================================================

# --- Application Runtime ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL Database Connection (Prisma ORM) ---
DATABASE_URL="postgresql://depoma_user:CHANGE_ME_LOCAL_PASSWORD@localhost:5432/depoma_db?schema=public&connection_limit=10"

# --- JWT Authentication ---
JWT_SECRET="REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_HEX_SECRET_IN_ENV"
JWT_EXPIRES_IN="8h"

# --- Initial Admin Seed Account (Used only by prisma/seed.ts in local dev) ---
SEED_ADMIN_EMAIL="admin@depoma.local"
SEED_ADMIN_PASSWORD="CHANGE_ME_SEED_PASSWORD"
